--==================================================
-- WALL CLIMB
--==================================================
local CLIMB_BASE, CLIMB_REACH = 4, 2.8
local climbParams = RaycastParams.new()
climbParams.FilterType = Enum.RaycastFilterType.Exclude
local Climb = { active = false, auto = nil, normal = Vector3.zero, cool = 0 }

local function StopClimb()
    if not Climb.active then return end
    Climb.active, Climb.normal = false, Vector3.zero
    local hum = GetHumanoid()
    if hum then
        if Climb.auto ~= nil then hum.AutoRotate = Climb.auto end
        if hum:GetState() == Enum.HumanoidStateType.Climbing then hum:ChangeState(Enum.HumanoidStateType.Freefall) end
    end
    Climb.auto = nil
end

local function ClimbTick()
    if not Settings.WallClimb then return end
    if Flying or FC.on or Tracking.Follow or Settings.SpinOn then StopClimb() return end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (root and hum and hum.Health > 0) then StopClimb() return end
    if os.clock() < Climb.cool then return end

    local move = hum.MoveDirection
    local flat = Vector3.new(move.X, 0, move.Z)
    local look = root.CFrame.LookVector
    climbParams.FilterDescendantsInstances = { char }

    -- find the wall: where we are heading, the wall we already hold, or where we are looking
    local dirs = {}
    if flat.Magnitude > 0.1 then dirs[#dirs + 1] = flat.Unit end
    if Climb.active and Climb.normal.Magnitude > 0 then dirs[#dirs + 1] = -Climb.normal end
    local lf = Vector3.new(look.X, 0, look.Z)
    if lf.Magnitude > 0.1 then dirs[#dirs + 1] = lf.Unit end

    local hit
    for _, d in ipairs(dirs) do
        local r = workspace:Raycast(root.Position, d * CLIMB_REACH, climbParams)
        if r and math.abs(r.Normal.Y) < 0.6 then hit = r break end
    end
    if not hit then StopClimb() return end

    local n = Vector3.new(hit.Normal.X, 0, hit.Normal.Z)
    if n.Magnitude < 0.05 then StopClimb() return end
    n = n.Unit

    local toward = flat:Dot(-n)        -- >0 pushing into the wall, <0 pulling away
    local wantUp = UIS:IsKeyDown(Enum.KeyCode.Space) or hum.Jump
    local wantDown = UIS:IsKeyDown(Enum.KeyCode.LeftShift)

    if not Climb.active then
        if not (toward > 0.25 or wantUp) then return end -- only latch on when you push into the wall
        Climb.active = true
        Climb.auto = hum.AutoRotate
        hum.AutoRotate = false
    elseif toward < -0.35 and not wantUp then
        StopClimb() return -- walking away = let go
    end
    Climb.normal = n

    local speed = CLIMB_BASE * Settings.ClimbLevel
    local vy = 0
    if wantDown then vy = -speed
    elseif toward > 0.25 or wantUp then vy = speed end

    -- ledge: wall ends above our head -> pull ourselves over the top
    if vy > 0 then
        local head = workspace:Raycast(root.Position + Vector3.new(0, 2.6, 0), -n * CLIMB_REACH, climbParams)
        if not head then
            root.AssemblyLinearVelocity = Vector3.new(-n.X * 14, math.clamp(speed * 0.6, 22, 60), -n.Z * 14)
            Climb.cool = os.clock() + 0.45
            StopClimb()
            return
        end
    end

    -- strafe along the wall
    local tangent = flat - n * flat:Dot(n)
    tangent = Vector3.new(tangent.X, 0, tangent.Z)
    local side = tangent.Magnitude > 0.1 and tangent.Unit * math.min(speed, 40) * 0.6 or Vector3.zero

    root.AssemblyLinearVelocity = Vector3.new(0, vy, 0) + side + (-n * 4)
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(-n.X, 0, -n.Z))
    if hum:GetState() ~= Enum.HumanoidStateType.Climbing then hum:ChangeState(Enum.HumanoidStateType.Climbing) end
end

