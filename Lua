local function SwapText(oldLang, newLang)
    local ok, root = pcall(function() return Fluent.GUI or Window.Root end)
    if not (ok and root) then return false end
    local rev, to = REV[oldLang], STR[newLang]
    local patterns = {}
    for k, v in next, STR[oldLang] do
        if type(v) == "string" and v:find("%%d") then
            local p = v:gsub("[%(%)%.%%%+%-%*%?%[%]%^%$]", "%%%0"):gsub("%%%%d", "(%%d+)")
            patterns[#patterns+1] = { key = k, pattern = "^" .. p .. "$" }
        end
    end
    task.spawn(function()
        WalkTree(root, function(inst)
            if not (inst:IsA("TextLabel") or inst:IsA("TextButton")) then return end
            local k = rev[inst.Text]
            if k and to[k] then
                if inst.Text ~= to[k] then inst.Text = to[k] end
                return
            end
            for _, pt in ipairs(patterns) do
                local num = inst.Text:match(pt.pattern)
                if num then
                    local tmpl = to[pt.key]
                    if tmpl then
                        local ok2, newTxt = pcall(string.format, tmpl, tonumber(num))
                        if ok2 and inst.Text ~= newTxt then inst.Text = newTxt end
                    end
                    break
                end
            end
        end)
    end)
    return true
end

