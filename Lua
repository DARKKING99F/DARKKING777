-- FREECAM (v2: yaw/pitch, PC + Mobile + Gamepad)
--==================================================
for k, v in next, {
    conns = {}, pos = Vector3.zero, yaw = 0, pitch = 0,
    subject = nil, savedWalk = nil, savedJumpPower = nil, savedJumpHeight = nil,
    touches = {}, rightDown = false, gui = nil,
    up = false, down = false, fast = false, gpLook = Vector2.zero,
    speed = 40, root = nil, wasAnchored = false,
} do FC[k] = v end

local FC_SENS_MOUSE, FC_SENS_TOUCH, FC_PITCH_LIMIT = 0.3, 0.25, math.rad(89)

local function FCLook(dx, dy, sens)
    FC.yaw = (FC.yaw - math.rad(dx * sens)) % (math.pi * 2)
    FC.pitch = math.clamp(FC.pitch - math.rad(dy * sens), -FC_PITCH_LIMIT, FC_PITCH_LIMIT)
end

local function MakeFCGui()
    local gui = New("ScreenGui", {
        Name = "DarkHubFreecam", ResetOnSpawn = false, DisplayOrder = 997, IgnoreGuiInset = true,
    })
    if not pcall(function() gui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end) then
        gui.Parent = LP:WaitForChild("PlayerGui")
    end
    local function isPress(i)
        return i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1
    end
    local function makeBtn(text, yOff, onDown, onUp)
        local b = New("TextButton", {
            Size = UDim2.fromOffset(56, 56), AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -16, 0.5, yOff),
            BackgroundColor3 = C(18, 18, 24), BackgroundTransparency = 0.25,
            AutoButtonColor = false, Text = text, Font = Enum.Font.GothamBold,
            TextSize = 14, TextColor3 = C(240, 240, 245),
        }, gui)
        New("UICorner", { CornerRadius = UDim.new(1, 0) }, b)
        New("UIStroke", { Thickness = 1.5, Color = C(90, 220, 150), Transparency = 0.4 }, b)
        b.InputBegan:Connect(function(i) if isPress(i) then onDown(b) end end)
        b.InputEnded:Connect(function(i) if onUp and isPress(i) then onUp(b) end end)
        return b
    end
    makeBtn("UP", -70, function() FC.up = true end, function() FC.up = false end)
    makeBtn("DOWN", 0, function() FC.down = true end, function() FC.down = false end)
    makeBtn("FAST", 70, function(b)
        FC.fast = not FC.fast
        b.BackgroundColor3 = FC.fast and C(40, 120, 80) or C(18, 18, 24)
    end)
    return gui
end

local function FCStep(dt)
    local c = workspace.CurrentCamera
    if not (FC.on and c) then return end
    if c.CameraType ~= Enum.CameraType.Scriptable then c.CameraType = Enum.CameraType.Scriptable end

    -- gamepad right stick look
    if FC.gpLook.Magnitude > 0.15 then
        FCLook(FC.gpLook.X * 120 * dt, -FC.gpLook.Y * 120 * dt, 1)
    end

    local rot = CFrame.fromOrientation(FC.pitch, FC.yaw, 0)

    -- keyboard
    local kb = Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then kb += rot.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then kb -= rot.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then kb -= rot.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.D) then kb += rot.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.E) then kb += Vector3.yAxis end
    if UIS:IsKeyDown(Enum.KeyCode.Q) then kb -= Vector3.yAxis end

    local move
    if kb.Magnitude > 0 then
        move = kb.Unit
    else
        move = Vector3.zero
        -- mobile thumbstick / gamepad left stick (via Humanoid.MoveDirection)
        local hum = GetHumanoid()
        local md = hum and hum.MoveDirection or Vector3.zero
        if md.Magnitude > 0 then
            local l = CFrame.fromOrientation(0, FC.yaw, 0):VectorToObjectSpace(md)
            move = rot.LookVector * (-l.Z) + rot.RightVector * l.X
        end
    end
    local vert = (FC.up and 1 or 0) - (FC.down and 1 or 0)
    if vert ~= 0 then move += Vector3.yAxis * vert end
    if move.Magnitude > 1 then move = move.Unit end

    local boost = (FC.fast or UIS:IsKeyDown(Enum.KeyCode.LeftShift)) and 4 or 1
    FC.pos += move * FC.speed * boost * dt
    c.CFrame = CFrame.new(FC.pos) * rot
end

local function StopFreecam()
    if not FC.on then return end
    FC.on = false
    for _, cn in ipairs(FC.conns) do pcall(function() cn:Disconnect() end) end
    table.clear(FC.conns)
    if FC.gui then FC.gui:Destroy() FC.gui = nil end
    FC.touches, FC.rightDown = {}, false
    FC.up, FC.down, FC.fast, FC.gpLook = false, false, false, Vector2.zero
    pcall(function() UIS.MouseBehavior = Enum.MouseBehavior.Default end)

    local cam = workspace.CurrentCamera
    if cam then
        cam.CameraType = Enum.CameraType.Custom
        if FC.subject and FC.subject.Parent then cam.CameraSubject = FC.subject
        else local h = GetHumanoid() if h then cam.CameraSubject = h end end
    end
    local hum = GetHumanoid()
    if hum then
        if Settings.WalkOn then hum.WalkSpeed = WALK_BASE * Settings.WalkLevel
        elseif FC.savedWalk then hum.WalkSpeed = FC.savedWalk end
        if hum.UseJumpPower and FC.savedJumpPower then hum.JumpPower = FC.savedJumpPower end
        if not hum.UseJumpPower and FC.savedJumpHeight then hum.JumpHeight = FC.savedJumpHeight end
    end
    if FC.root and FC.root.Parent then
        FC.root.Anchored = FC.wasAnchored
    end
    FC.root, FC.wasAnchored = nil, false
    FC.subject, FC.savedWalk = nil, nil
end

local function StartFreecam()
    local cam = workspace.CurrentCamera
    if not cam then return false end
    if FC.on then return true end
    FC.on = true
    FC.pos = cam.CFrame.Position
    local rx, ry = cam.CFrame:ToOrientation()
    FC.pitch, FC.yaw = math.clamp(rx, -FC_PITCH_LIMIT, FC_PITCH_LIMIT), ry
    FC.subject = cam.CameraSubject
    cam.CameraType = Enum.CameraType.Scriptable

    local hum = GetHumanoid()
    if hum then
        FC.savedWalk = hum.WalkSpeed
        FC.savedJumpPower, FC.savedJumpHeight = hum.JumpPower, hum.JumpHeight
        hum.WalkSpeed = 0
        if hum.UseJumpPower then hum.JumpPower = 0 else hum.JumpHeight = 0 end
    end

    -- fully lock the body: nobody can push it, moving platforms can't carry it
    local root = GetRoot()
    if root then
        FC.root, FC.wasAnchored = root, root.Anchored
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.Anchored = true
    end

    if UIS.TouchEnabled then FC.gui = MakeFCGui() end

    local TOUCH, UT = Enum.UserInputType.Touch, Enum.UserInputType
    table.insert(FC.conns, UIS.InputBegan:Connect(function(i, processed)
        if not FC.on or processed then return end
        if i.UserInputType == UT.MouseButton2 then
            FC.rightDown = true
            UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
        elseif i.UserInputType == TOUCH then
            local vp = workspace.CurrentCamera.ViewportSize
            local p = i.Position
            -- skip the lower-left area (movement thumbstick)
            if not (p.X < vp.X * 0.3 and p.Y > vp.Y * 0.5) then FC.touches[i] = true end
        end
    end))
    table.insert(FC.conns, UIS.InputChanged:Connect(function(i)
        if not FC.on then return end
        local t = i.UserInputType
        if t == UT.MouseMovement then
            if FC.rightDown then FCLook(i.Delta.X, i.Delta.Y, FC_SENS_MOUSE) end
        elseif t == TOUCH then
            if FC.touches[i] then FCLook(i.Delta.X, i.Delta.Y, FC_SENS_TOUCH) end
        elseif i.KeyCode == Enum.KeyCode.Thumbstick2 then
            FC.gpLook = Vector2.new(i.Position.X, i.Position.Y)
        end
    end))
    table.insert(FC.conns, UIS.InputEnded:Connect(function(i)
        local t = i.UserInputType
        if t == UT.MouseButton2 then
            FC.rightDown = false
            UIS.MouseBehavior = Enum.MouseBehavior.Default
        elseif t == TOUCH then
            FC.touches[i] = nil
        elseif i.KeyCode == Enum.KeyCode.Thumbstick2 then
            FC.gpLook = Vector2.zero
        end
    end))
    table.insert(FC.conns, RunService.RenderStepped:Connect(FCStep))
    return true
end

