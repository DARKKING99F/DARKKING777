local SPIN_BASE = 1
local spinBV, spinAuto

local function StopSpin()
    if spinBV then spinBV:Destroy() spinBV = nil end
    local hum = GetHumanoid()
    if hum and spinAuto ~= nil then hum.AutoRotate = spinAuto end
    spinAuto = nil
end

local function ApplySpin()
    if not Settings.SpinOn then return end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (root and hum) then return end
    if not (spinBV and spinBV.Parent == root) then
        if spinBV then spinBV:Destroy() end
        spinBV = New("BodyAngularVelocity", { Name = "DarkHubSpin", MaxTorque = Vector3.new(0, 9e9, 0), P = 1e5 }, root)
    end
    if spinAuto == nil then spinAuto = hum.AutoRotate end
    if hum.AutoRotate then hum.AutoRotate = false end
    local av = Vector3.new(0, Settings.SpinLevel * SPIN_BASE * (Settings.SpinReverse and -1 or 1), 0)
    if spinBV.AngularVelocity ~= av then spinBV.AngularVelocity = av end
end

