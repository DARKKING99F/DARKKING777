-- WALK ON WATER
--==================================================
local WW = { conn = nil, part = nil, acc = 0, surf = nil }
local wwParams = RaycastParams.new()
wwParams.FilterType = Enum.RaycastFilterType.Exclude
wwParams.IgnoreWater = false

local function StopWater()
    if WW.conn then WW.conn:Disconnect() WW.conn = nil end
    if WW.part then WW.part:Destroy() WW.part = nil end
    WW.surf = nil
end

local function StartWater()
    if WW.conn then return end
    WW.acc = 0
    WW.conn = RunService.Heartbeat:Connect(function(dt)
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        if not (WW.part and WW.part.Parent) then
            WW.part = New("Part", { Name = "DarkHubWater", Anchored = true, CanCollide = false, Transparency = 1,
                CanQuery = false, CanTouch = false, CastShadow = false, Locked = true, Size = Vector3.new(16, 1, 16) }, workspace)
        end
        WW.acc += dt
        if WW.acc >= 0.1 then
            WW.acc = 0
            wwParams.FilterDescendantsInstances = { char }
            local hit = workspace:Raycast(root.Position + Vector3.new(0, 4, 0), Vector3.new(0, -64, 0), wwParams)
            WW.surf = (hit and hit.Material == Enum.Material.Water) and hit.Position.Y or nil
            local hum = char:FindFirstChildOfClass("Humanoid")
            if WW.surf and hum then
                local off = hum.RigType == Enum.HumanoidRigType.R6 and 3 or (hum.HipHeight + root.Size.Y / 2)
                local feet = root.Position.Y - off
                if feet < WW.surf - 0.2 and feet > WW.surf - 5 then
                    root.CFrame += Vector3.new(0, WW.surf - feet + 0.1, 0)
                    local v = root.AssemblyLinearVelocity
                    root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
                end
            end
        end
        local part, on = WW.part, WW.surf ~= nil
        if part.CanCollide ~= on then part.CanCollide = on end
        if on then part.CFrame = CFrame.new(root.Position.X, WW.surf - 0.5, root.Position.Z) end
    end)
end

--==================================================
-- SAFETY (Anti-Void + Anti-Fling)
--==================================================
local lastSafe
local voidParams = RaycastParams.new()
voidParams.FilterType = Enum.RaycastFilterType.Exclude

local function SafetyTick()
    if not (Settings.AntiVoid or Settings.NoclipOn) then return end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (root and hum and hum.Health > 0) then return end
    if hum.FloorMaterial ~= Enum.Material.Air then
        lastSafe = root.CFrame + Vector3.new(0, 2, 0)
        return
    end
    if not lastSafe then return end
    local y, danger = root.Position.Y, false
    local destroy = workspace.FallenPartsDestroyHeight
    if Settings.AntiVoid and type(destroy) == "number" and destroy > -1e6 and y < destroy + 80 then
        danger = true
    elseif Settings.NoclipOn and y < lastSafe.Position.Y - 60 and root.AssemblyLinearVelocity.Y < -40 then
        voidParams.FilterDescendantsInstances = { char }
        danger = workspace:Raycast(root.Position, Vector3.new(0, -4000, 0), voidParams) == nil
    end
    if danger then
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = lastSafe
        Note(T("nt_safe"), T("n_void"), 3, "warn")
    end
end

local function AntiFlingTick()
    if not Settings.AntiFling then return end
    if Flying or Settings.SpinOn then return end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local lin = root.AssemblyLinearVelocity.Magnitude
    local ang = root.AssemblyAngularVelocity.Magnitude
    if lin > 3000 or (lin > 800 and ang > 50) then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

