-- 5. 🕒 FPS / Ping Counter UI
local isFpsInfoOn = false
local fpsGui = nil
FpsInfoBtn.MouseButton1Click:Connect(function()
	PlayClickSound()
	isFpsInfoOn = not isFpsInfoOn
	if isFpsInfoOn then
		FpsInfoBtn.Text = "🕒 แสดงค่า FPS / Ping (ON)"
		FpsInfoBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
		
		fpsGui = Instance.new("ScreenGui")
		fpsGui.Name = "FpsPingDisplay"
		fpsGui.Parent = playerGui
		
		local label = Instance.new("TextLabel", fpsGui)
		label.Size = UDim2.new(0, 150, 0, 40)
		label.Position = UDim2.new(0, 10, 0, 10)
		label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		label.BackgroundTransparency = 0.5
		label.TextColor3 = Color3.fromRGB(0, 255, 0)
		label.Font = Enum.Font.Code
		label.TextSize = 16
		Instance.new("UICorner", label).CornerRadius = UDim.new(0, 8)
		
		task.spawn(function()
			local lastTick = tick()
			local frames = 0
			while fpsGui and fpsGui.Parent do
				frames = frames + 1
				if tick() - lastTick >= 1 then
					local fps = math.floor(frames / (tick() - lastTick))
					local ping = math.floor(player:GetNetworkPing() * 1000)
					label.Text = string.format("FPS: %d | Ping: %dms", fps, ping)
					frames = 0
					lastTick = tick()
				end
				task.wait()
			end
		end)
	else
		FpsInfoBtn.Text = "🕒 แสดงค่า FPS / Ping (OFF)"
		FpsInfoBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		if fpsGui then fpsGui:Destroy() end
	end
end)

