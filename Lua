local HttpService = game:GetService("HttpService")
local HOP_FILE = "DarkHub/hop.txt"
local Hop = { max = 1, strict = false, auto = false, busy = false, failed = false, tried = {}, nextAuto = 0 }

local function SaveHop()
    pcall(function()
        if not writefile then return end
        if makefolder and isfolder and not isfolder("DarkHub") then makefolder("DarkHub") end
        writefile(HOP_FILE, string.format("%d|%d|%d", Hop.auto and 1 or 0, math.floor(Hop.max), Hop.strict and 1 or 0))
    end)
end

pcall(function()
    if isfile and isfile(HOP_FILE) then
        local a, m, st = readfile(HOP_FILE):match("(%d)|(%d+)|(%d)")
        if a then
            Hop.auto, Hop.max, Hop.strict = a == "1", math.clamp(tonumber(m) or 1, 1, 20), st == "1"
        end
    end
end)

-- returns decoded JSON, or nil + reason ("rate" / "http" / "json")
local function HttpGetJSON(url)
    local body
    pcall(function() body = game:HttpGet(url) end)
    if type(body) ~= "string" or body == "" then
        local req = (syn and syn.request) or request or http_request or (fluxus and fluxus.request)
        if req then
            local ok, res = pcall(req, { Url = url, Method = "GET" })
            if ok and res then
                if res.StatusCode == 429 then return nil, "rate" end
                body = res.Body
            end
        end
    end
    if type(body) ~= "string" or body == "" then return nil, "http" end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
    if not ok or type(data) ~= "table" then return nil, "json" end
    if data.errors then return nil, "rate" end
    return data
end

-- public servers sorted emptiest-first; skips this server, full ones and ones we already tried
local function CollectServers(maxPages)
    local list, cursor, lastErr = {}, nil, nil
    for _ = 1, maxPages do
        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100%s",
            game.PlaceId, cursor and ("&cursor=" .. cursor) or "")
        local data, err
        for attempt = 1, 3 do
            data, err = HttpGetJSON(url)
            if data then break end
            task.wait(err == "rate" and 3 * attempt or 1.5)
        end
        if not data then lastErr = err break end
        for _, sv in ipairs(data.data or {}) do
            local playing, cap = sv.playing or 0, sv.maxPlayers or 0
            if sv.id ~= game.JobId and not Hop.tried[sv.id] and playing >= 1 and playing < cap then
                list[#list + 1] = sv
            end
        end
        cursor = data.nextPageCursor
        if not cursor or #list >= 15 then break end
    end
    table.sort(list, function(a, b)
        if a.playing ~= b.playing then return a.playing < b.playing end
        return (a.ping or 9e9) < (b.ping or 9e9)
    end)
    return list, lastErr
end

Track(TeleportService.TeleportInitFailed:Connect(function(plr)
    if plr == LP then Hop.failed = true end
end))

local function HopToLow(force, silent)
    if Hop.busy then return end
    if game.PrivateServerId ~= "" then
        if not silent then Note(T("nt_hop"), T("n_hop_priv"), 4, "error") end
        return
    end
    if not force and #Players:GetPlayers() <= Hop.max then
        if not silent then Note(T("nt_hop"), T("n_hop_already"), 3, "info") end
        return
    end
    Hop.busy = true
    task.spawn(function()
        if not silent then Note(T("nt_hop"), T("n_hop_search"), 3, "info") end
        local list, err = CollectServers(3)
        local pool = list
        if Hop.strict then
            pool = {}
            for _, sv in ipairs(list) do
                if sv.playing <= Hop.max then pool[#pool + 1] = sv end
            end
        end
        -- never move to a server that isn't emptier than this one (unless forced by the button)
        if not force and pool[1] and pool[1].playing >= #Players:GetPlayers() then pool = {} end
        if #pool == 0 then
            Hop.nextAuto = os.clock() + 120
            if not silent then
                local isHttp = err and #list == 0
                Note(T("nt_hop"), T(isHttp and "n_hop_http" or "n_hop_none"), 5, isHttp and "error" or "warn")
            end
            Hop.busy = false
            return
        end
        for i = 1, math.min(#pool, 8) do
            if Fluent.Unloaded then break end
            local sv = pool[i]
            Hop.tried[sv.id] = true
            Hop.failed = false
            Note(T("nt_hop"), T("n_hop_join", sv.playing), 4, "success")
            local ok = pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, sv.id, LP) end)
            local t0 = os.clock()
            repeat task.wait(0.25) until Hop.failed or not ok or Fluent.Unloaded or os.clock() - t0 > 20
        end
        Hop.busy = false
        if not Fluent.Unloaded then
            Hop.nextAuto = os.clock() + 30
            Note(T("nt_hop"), T("n_hop_fail"), 4, "error")
        end
    end)
end

-- Auto Hop: after (re)load, keep moving until the server is within the target
task.spawn(function()
    task.wait(8)
    while not Fluent.Unloaded do
        if Hop.auto and not Hop.busy and os.clock() >= Hop.nextAuto and #Players:GetPlayers() > Hop.max then
            pcall(HopToLow, false, true)
        end
        task.wait(10)
    end
end)

