-- CLIP
--==================================================
local Clip = { users = {}, conn = nil, parts = {}, char = nil }

local function ClipCache(char)
    Clip.char, Clip.parts = char, {}
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then table.insert(Clip.parts, p) end
    end
end

local function ClipStep()
    local char = LP.Character
    if not char then return end
    if char ~= Clip.char or #Clip.parts == 0 then ClipCache(char) end
    for _, p in ipairs(Clip.parts) do
        if p.CanCollide then p.CanCollide = false end
    end
end

local function ClipAcquire(who)
    Clip.users[who] = true
    if not Clip.conn then Clip.conn = RunService.Stepped:Connect(ClipStep) end
end

local function ClipRelease(who)
    if not Clip.users[who] then return end
    Clip.users[who] = nil
    if next(Clip.users) ~= nil then return end
    if Clip.conn then Clip.conn:Disconnect() Clip.conn = nil end
    for _, p in ipairs(Clip.parts) do
        if p.Parent then p.CanCollide = true end
    end
    Clip.parts, Clip.char = {}, nil
end

