local function SetOpt(id, v)
    local o = Fluent.Options[id]
    if o and o.Value ~= v then o:SetValue(v) end
end

local Tracking = { Spec = nil, Follow = nil, Dist = 1, Height = 0.2 }
local followOffset = CFrame.new(0, Tracking.Height, Tracking.Dist)
local function UpdateOffset() followOffset = CFrame.new(0, Tracking.Height, Tracking.Dist) end

local specConns = {}

local function SpecApply()
    local target, cam = Tracking.Spec, workspace.CurrentCamera
    if not (target and cam) then return end
    local ch = target.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if hum and cam.CameraSubject ~= hum then cam.CameraSubject = hum end
end

local function StopSpectate()
    local was = Tracking.Spec ~= nil
    Tracking.Spec = nil
    for _, c in ipairs(specConns) do c:Disconnect() end
    table.clear(specConns)
    if not was then return end
    local cam, hum = workspace.CurrentCamera, GetHumanoid()
    if cam and hum then cam.CameraSubject = hum end
end

local function StartSpectate(plr)
    for _, c in ipairs(specConns) do c:Disconnect() end
    table.clear(specConns)
    Tracking.Spec = plr
    local function hookCam()
        local cam = workspace.CurrentCamera
        if cam then
            table.insert(specConns, cam:GetPropertyChangedSignal("CameraSubject"):Connect(SpecApply))
        end
    end
    hookCam()
    table.insert(specConns, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        hookCam()
        SpecApply()
    end))
    table.insert(specConns, plr.CharacterAdded:Connect(function(char)
        task.spawn(function()
            char:WaitForChild("Humanoid", 5)
            if Tracking.Spec == plr then SpecApply() end
        end)
    end))
    SpecApply()
end

local followConns = {}

local function GetTargetRoot(ch)
    if not ch then return nil end
    return ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
        or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") or ch:FindFirstChild("Head")
end

local function StickStep()
    local target = Tracking.Follow
    if not target then return end
    local tRoot = GetTargetRoot(target.Character)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (tRoot and tRoot:IsA("BasePart") and root) then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and not hum.PlatformStand then hum.PlatformStand = true end
    root.CFrame = tRoot.CFrame * followOffset
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

local function StopFollow()
    local was = Tracking.Follow ~= nil or #followConns > 0
    Tracking.Follow = nil
    for _, c in ipairs(followConns) do c:Disconnect() end
    table.clear(followConns)
    if not was then return end
    ClipRelease("follow")
    local hum = GetHumanoid()
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function StartFollow(plr)
    if Flying then StopFly() SetOpt("FlyToggle", false) end
    if Settings.SpinOn then SetOpt("SpinToggle", false) end
    Tracking.Follow = plr
    if #followConns > 0 then return end
    ClipAcquire("follow")
    table.insert(followConns, RunService.Heartbeat:Connect(function()
        local target = Tracking.Follow
        if target and target.Parent ~= Players then
            StopFollow()
            SetOpt("FollowToggle", false)
            Note(T("fol_t"), T("n_fol_left"))
            return
        end
        StickStep()
    end))
    table.insert(followConns, RunService.RenderStepped:Connect(StickStep))
end

