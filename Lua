local function MakePicker(sec, id, title, desc, onSwitch)
    local map, drop, query = {}, nil, ""
    local function Build()
        table.clear(map)
        local labels = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and (query == ""
                or plr.DisplayName:lower():find(query, 1, true)
                or plr.Name:lower():find(query, 1, true)) then
                local l = string.format("%s (@%s)", plr.DisplayName, plr.Name)
                map[l] = plr
                table.insert(labels, l)
            end
        end
        table.sort(labels)
        if #labels == 0 then labels = { T(query == "" and "no_players" or "no_match") } end
        return labels
    end
    local input = sec:AddInput(id .. "Search", { Title = T("search_t"), Description = T("search_d"),
        Default = "", Placeholder = "Name / @username", Numeric = false, Finished = false })
    drop = sec:AddDropdown(id, { Title = title, Description = desc, Values = Build(), Default = 1 })
    drop:OnChanged(function() onSwitch(map[drop.Value]) end)
    local function Rebuild()
        local labels = Build()
        drop:SetValues(labels)
        if not map[drop.Value] then drop:SetValue(labels[1]) end
    end
    table.insert(LangHooks, Rebuild)
    local pending = false
    local function Schedule(delay)
        if pending then return end
        pending = true
        task.delay(delay, function() pending = false if not Fluent.Unloaded then Rebuild() end end)
    end
    input:OnChanged(function(v)
        local q = tostring(v or ""):lower()
        q = q:gsub("^%s+", ""):gsub("%s+$", ""):gsub("^@", "")
        query = q
        Schedule(0.2)
    end)
    Track(Players.PlayerAdded:Connect(function() Schedule(0.3) end))
    Track(Players.PlayerRemoving:Connect(function() Schedule(0.3) end))
    return function() return map[drop.Value] end, Rebuild
end

