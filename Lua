local loop
local accStats, accVis, accSafe = 0, 0, 0
loop = RunService.Heartbeat:Connect(function(dt)
    if not Fluent.Unloaded then
        accStats += dt
        if accStats >= 0.1 then accStats = 0 ApplyStats() ApplySpin() end
        accVis += dt
        if accVis >= 0.5 then accVis = 0 ApplyVisuals() end
        accSafe += dt
        if accSafe >= 0.25 then accSafe = 0 SafetyTick() end
        UpdateESP()
        return
    end
