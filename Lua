local function Level(v) return math.clamp(math.floor(v + 0.5), 1, MAX_LEVEL) end

local function AddToggle(sec, id, title, desc, default, fn)
    local t = sec:AddToggle(id, { Title = title, Description = desc, Default = default })
    t:OnChanged(function() fn(t.Value) end)
    return t
end

local function AddSlider(sec, id, title, desc, default, min, max, fn)
    local s = sec:AddSlider(id, { Title = title, Description = desc, Default = default, Min = min, Max = max, Rounding = 0 })
    s:OnChanged(fn)
    return s
end

local function SwapText(oldLang, newLang)
    local ok, root = pcall(function() return Fluent.GUI or Window.Root end)
    if not (ok and root) then return false end
    local rev, to = REV[oldLang], STR[newLang]
    task.spawn(function()
        local slice = Slicer()
        for _, inst in ipairs(root:GetDescendants()) do
            if inst:IsA("TextLabel") or inst:IsA("TextButton") then
                local k = rev[inst.Text]
                if k and to[k] and inst.Text ~= to[k] then inst.Text = to[k] end
            end
            slice()
        end
    end)
    return true
end

