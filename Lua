-- [[ ระบบวาร์ปกลับจุดเกิด (Teleport SafeZone) ]]
TpBtn.MouseButton1Click:Connect(function()
	PlayClickSound()
	local char = player.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		-- ค้นหาจุด SpawnLocation หรือพาตัวละครกลับจุดเริ่มต้น
		local spawnLocation = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
		if spawnLocation then
			char.HumanoidRootPart.CFrame = spawnLocation.CFrame + Vector3.new(0, 3, 0)
		else
			-- ถ้าไม่เจอเซ็ตตำแหน่งขึ้นไปข้างบนแทน
			char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + Vector3.new(0, 10, 0)
		end
	end
end)

