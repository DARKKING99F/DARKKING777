-- FPS BOOST
--==================================================
local Boost = setmetatable({}, { __mode = "k" })
local BoostGen, BoostConn, OrigQuality = 0, {}, nil
local MapProps = { "ColorMap", "NormalMap", "MetalnessMap", "RoughnessMap" }

local function Mod(inst, prop, val)
    if inst[prop] == val then return end
    local rec = Boost[inst] if not rec then rec = {} Boost[inst] = rec end
    if rec[prop] == nil then rec[prop] = inst[prop] end
    inst[prop] = val
end

local function Put(inst, prop, val) inst[prop] = val end

local function Reduce(inst)
    if inst:IsA("PostEffect") or inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
        or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") or inst:IsA("Clouds") then
        Mod(inst, "Enabled", false)
    elseif inst:IsA("Decal") then
        if inst.Name ~= "face" then Mod(inst, "Transparency", 1) end
    elseif inst:IsA("SurfaceAppearance") then
        for _, p in ipairs(MapProps) do pcall(Mod, inst, p, "") end
    elseif inst:IsA("Terrain") then
        pcall(Mod, inst, "Decoration", false)
        Mod(inst, "WaterWaveSize", 0) Mod(inst, "WaterWaveSpeed", 0) Mod(inst, "WaterReflectance", 0)
    elseif inst:IsA("BasePart") then
        if inst.Name == "DarkHubWater" then return end
        Mod(inst, "Material", Enum.Material.SmoothPlastic)
        Mod(inst, "Reflectance", 0) Mod(inst, "CastShadow", false)
        if inst:IsA("MeshPart") then
            Mod(inst, "TextureID", "") Mod(inst, "RenderFidelity", Enum.RenderFidelity.Performance)
        end
    end
end

local function SetBoost(on)
    BoostGen += 1 local gen = BoostGen
    for _, c in ipairs(BoostConn) do c:Disconnect() end
    table.clear(BoostConn)
    if on then
        pcall(function()
            local r = settings().Rendering
            OrigQuality = OrigQuality or r.QualityLevel
            r.QualityLevel = Enum.QualityLevel.Level01
        end)
        local roots = { workspace, Lighting }
        for _, root in ipairs(roots) do
            table.insert(BoostConn, root.DescendantAdded:Connect(function(i) pcall(Reduce, i) end))
        end
        task.spawn(function()
            for _, root in ipairs(roots) do
                if gen ~= BoostGen then return end
                WalkTree(root, function(inst)
                    if gen ~= BoostGen then return true end
                    pcall(Reduce, inst)
                end, Slicer(0.008))
            end
            Note(T("boost_t"), T("n_boost_done"), 3, "success")
        end)
    else
        pcall(function()
            if OrigQuality then settings().Rendering.QualityLevel = OrigQuality end
            OrigQuality = nil
        end)
        task.spawn(function()
            local slice = Slicer(0.006)
            for inst, rec in next, Boost do
                if gen ~= BoostGen then return end
                for p, v in next, rec do pcall(Put, inst, p, v) end
                Boost[inst] = nil slice()
            end
        end)
    end
end

