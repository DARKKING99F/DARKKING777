-- WAYPOINT PERSISTENCE
--==================================================
local WP_FILE = "DarkHub/waypoints.txt"
local Waypoints, WaypointNames = {}, {}

local function SerializeCF(cf)
    local p, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
    return string.format("%.4f,%.4f,%.4f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f",
        p.X, p.Y, p.Z, r00, r01, r02, r10, r11, r12, r20, r21, r22)
end

local function DeserializeCF(s)
    local parts = {}
    for num in s:gmatch("[^,]+") do parts[#parts+1] = tonumber(num) end
    if #parts < 12 then return nil end
    local ok, cf = pcall(CFrame.new,
        parts[1], parts[2], parts[3],
        parts[4], parts[5], parts[6],
        parts[7], parts[8], parts[9],
        parts[10], parts[11], parts[12])
    if ok then return cf end
end

local function SanitizeName(s) return (tostring(s or ""):gsub("[|\n\r]", " ")) end

local function SaveWaypointsToFile()
    pcall(function()
        if not writefile then return end
        if makefolder and isfolder and not isfolder("DarkHub") then makefolder("DarkHub") end
        local lines = {}
        for i = 1, 5 do
            local wp = Waypoints[i]
            if wp then
                lines[#lines+1] = i .. "|" .. SanitizeName(WaypointNames[i] or ("Slot " .. i)) .. "|" .. SerializeCF(wp)
            end
        end
        writefile(WP_FILE, table.concat(lines, "\n"))
    end)
end

local function LoadWaypointsFromFile()
    pcall(function()
        if not isfile or not isfile(WP_FILE) then return end
        local content = readfile(WP_FILE)
        for line in content:gmatch("[^\n]+") do
            local parts = {}
            for part in line:gmatch("[^|]+") do parts[#parts+1] = part end
            if #parts >= 3 then
                local idx = tonumber(parts[1])
                if idx and idx >= 1 and idx <= 5 then
                    WaypointNames[idx] = parts[2]
                    Waypoints[idx] = DeserializeCF(parts[3])
                end
            end
        end
    end)
end
LoadWaypointsFromFile()

