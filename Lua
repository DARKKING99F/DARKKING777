local Flying = false
local flyBV, flyBG, flyConn

local function StopFly()
    Flying = false
    if flyConn then flyConn:Disconnect() flyConn = nil end
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end

    local hum = GetHumanoid()
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function StartFly()
    local hum = GetHumanoid()
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then return false end

    Flying = true
    hum.PlatformStand = true
    flyBV = New("BodyVelocity", { MaxForce = Vector3.new(9e9, 9e9, 9e9), Velocity = Vector3.zero }, root)
    flyBG = New("BodyGyro", { MaxTorque = Vector3.new(9e9, 9e9, 9e9), P = 9e4, CFrame = root.CFrame }, root)

    flyConn = RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        if not (Flying and cam and root.Parent) or hum.Health <= 0 then return end

        local move = cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
        local dir = cam.CFrame.LookVector * -move.Z + cam.CFrame.RightVector * move.X

        flyBV.Velocity = (dir.Magnitude > 0 and dir.Unit or dir) * (Settings.FlySpeed * FLY_BASE)
        flyBG.CFrame = cam.CFrame
    end)
    return true
end

--==================================================
-- WALK / JUMP (เขียนค่าเฉพาะตอนค่าไม่ตรง ไม่เขียนซ้ำทุกเฟรม)
--==================================================
local Orig = {}

local function RestoreWalk()
    local hum = GetHumanoid()
    if hum and Orig.Walk then hum.WalkSpeed = Orig.Walk end
    Orig.Walk = nil
end

local function RestoreJump()
    local hum = GetHumanoid()
    if hum and Orig.Jump then
        hum[Orig.UsePower and "JumpPower" or "JumpHeight"] = Orig.Jump
    end
    Orig.Jump, Orig.UsePower = nil, nil
end

local function ApplyStats()
    if not (Settings.WalkOn or Settings.JumpOn) then return end
    local hum = GetHumanoid()
    if not hum then return end

    if Settings.WalkOn then
        Orig.Walk = Orig.Walk or hum.WalkSpeed
        local v = WALK_BASE * Settings.WalkLevel
        if hum.WalkSpeed ~= v then hum.WalkSpeed = v end
    end

    if Settings.JumpOn then
        local power = JUMP_BASE * Settings.JumpLevel
        if Orig.Jump == nil then
            Orig.UsePower = hum.UseJumpPower
            Orig.Jump = hum.UseJumpPower and hum.JumpPower or hum.JumpHeight
        end
        if hum.UseJumpPower then
            if hum.JumpPower ~= power then hum.JumpPower = power end
        else
            local h = power ^ 2 / (2 * workspace.Gravity)
            if hum.JumpHeight ~= h then hum.JumpHeight = h end
        end
    end
end

Track(LP.CharacterAdded:Connect(function()
    table.clear(Orig)
    if Flying then
        StopFly()
        if Fluent.Options.FlyToggle then Fluent.Options.FlyToggle:SetValue(false) end
    end
end))

