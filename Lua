    local function BuildESP(kind)
        local sec = Tabs.ESP:AddSection(T("sec_" .. kind))
        AddToggle(sec, "ESP" .. kind, T("esp_" .. kind .. "_t"), T("esp_" .. kind .. "_d"), false, function(v) SetCat(kind, v) end)
        AddToggle(sec, "Info" .. kind, T("info_" .. kind .. "_t"), T("info_" .. kind .. "_d"), true, function(v) Cats[kind].info = v end)
        local picker = sec:AddColorpicker("Color" .. kind, {
            Title = T("col_" .. kind .. "_t"), Description = T("col_" .. kind .. "_d"), Default = Cats[kind].color,
        })
        picker:OnChanged(function() Cats[kind].color = picker.Value end)
    end

    BuildESP("Player")
    BuildESP("Item")
end

do -- FLY
