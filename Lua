do -- LANGUAGE (หน้า Settings)
    local sec = Tabs.Settings:AddSection(T("sec_lang"))
    local drop = sec:AddDropdown("Language", {
        Title = T("lang_t"), Description = T("lang_d"),
        Values = LANG_NAMES, Default = (Lang == "th") and 2 or 1,
    })
    drop:OnChanged(function(v)
        local new = (v == LANG_NAMES[2]) and "th" or "en"
        if new == Lang then return end
        local old = Lang
        Lang = new
        SaveLang()
        for _, fn in ipairs(LangHooks) do pcall(fn) end -- สร้างรายชื่อผู้เล่นใหม่ตามภาษา
        local ok = SwapText(old, new)
        Note("DARK HUB", T(ok and "n_lang" or "n_lang_restart"), 3)
    end)
end

