-- [[ ระบบวิ่งไว ]]
local isSpeedEnabled = false
local speedConnection = nil
SpeedBtn.MouseButton1Click:Connect(function()
	PlayClickSound()
	isSpeedEnabled = not isSpeedEnabled
	if isSpeedEnabled then
		SpeedBtn.Text = "⚡ วิ่งไว (ON)"
		SpeedBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
		speedConnection = RunService.Stepped:Connect(function()
			if player.Character and player.Character:FindFirstChild("Humanoid") then
				player.Character.Humanoid.WalkSpeed = 160
			end
		end)
	else
		if speedConnection then speedConnection:Disconnect() end
		SpeedBtn.Text = "⚡ วิ่งไว (OFF)"
		SpeedBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		if player.Character and player.Character:FindFirstChild("Humanoid") then
			player.Character.Humanoid.WalkSpeed = 16
		end
	end
end)

-- [[ ระบบบินทะลุกำแพง (Fly / Noclip) ]]
local isFlyEnabled = false
local flyConnection = nil
FlyBtn.MouseButton1Click:Connect(function()
	PlayClickSound()
	isFlyEnabled = not isFlyEnabled
	if isFlyEnabled then
		FlyBtn.Text = "👻 บินทะลุ (ON)"
		FlyBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
		
		flyConnection = RunService.Stepped:Connect(function()
			local char = player.Character
			if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
				char.Humanoid.PlatformStand = true
				-- ปิดการชน (Noclip)
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
				-- ลอยตัวค้างบนอากาศ
				local hrp = char.HumanoidRootPart
				hrp.Velocity = Vector3.new(0, 1, 0)
			end
		end)
	else
		if flyConnection then flyConnection:Disconnect() end
		FlyBtn.Text = "👻 บินทะลุ (OFF)"
		FlyBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		if player.Character and player.Character:FindFirstChild("Humanoid") then
			player.Character.Humanoid.PlatformStand = false
		end
	end
end)

