local function CreateTab(name)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.9, 0, 0.15, 0)
	b.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	b.Text = name
	b.TextColor3 = Color3.new(0.8, 0.8, 0.8)
	b.Font = Enum.Font.GothamSemibold
	b.TextScaled = true
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	Instance.new("UICorner", b).CornerRadius = UDim.new(0.2, 0)
	b.Parent = Side

	local bStroke = Instance.new("UIStroke", b)
	bStroke.Thickness = 2
	bStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	bStroke.Transparency = 1
	ApplyThemeColor(bStroke)

	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(50, 50, 50), TextColor3 = Color3.new(1, 1, 1) }):Play()
		TweenService:Create(bStroke, TweenInfo.new(0.2), { Transparency = 0 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(30, 30, 30), TextColor3 = Color3.new(0.8, 0.8, 0.8) }):Play()
		TweenService:Create(bStroke, TweenInfo.new(0.2), { Transparency = 1 }):Play()
	end)
	return b
end

