-- [[ ฟังก์ชันสำหรับเล่นเสียง Click ]]
local function PlayClickSound(soundId)
	task.spawn(function()
		local sound = Instance.new("Sound")
		sound.SoundId = soundId or "rbxassetid://6895079853"
		sound.Volume = 0.5
		sound.Parent = SoundService
		sound:Play()
		sound.Ended:Connect(function()
			sound:Destroy()
		end)
	end)
end

-- [[ ฟังก์ชันสำหรับสร้างเอฟเฟกต์ไฟ RGB ]]
local function ApplyRGBEffect(object, speed)
	speed = speed or 1
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if not object or not object.Parent then
			connection:Disconnect()
			return
		end
		
		local hue = (tick() * speed) % 1
		local color = Color3.fromHSV(hue, 0.8, 1)

		if object:IsA("GuiObject") then
			if object:IsA("TextLabel") or object:IsA("TextButton") then
				object.TextColor3 = color
			end
			object.BorderColor3 = color
		elseif object:IsA("UIStroke") then
			object.Color = color
		end
	end)
end

