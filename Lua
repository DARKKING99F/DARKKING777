local function New(class, props, parent)
    local o = Instance.new(class)
    for k, v in next, props do o[k] = v end
    o.Parent = parent
    return o
end

-- ตัวแบ่งเฟรม: ทำงานหนักได้ไม่เกิน ~4ms ต่อเฟรม แล้วพักให้เกมวาดภาพ (กันค้างตอนสแกน)
local function Slicer(budget)
    budget = budget or 0.004
    local t = os.clock()
    return function()
        if os.clock() - t > budget then
            task.wait()
            t = os.clock()
        end
    end
end

