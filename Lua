-- [[ ระบบแก้แลค ( Smooth Clay Graphics + Remove Effects ) ]]
local isFixLagActive = false

local function ApplyFixLag()
	-- 1. ปรับปรุงระบบ Lighting (ลบหมอก เงา และ Effect)
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	Lighting.FogStart = 0
	
	for _, child in pairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("Clouds") then
			child:Destroy()
		end
	end
	
	-- 2. ฟังก์ชันปรับแต่งวัตถุเป็นภาพดินน้ำมันและลบเอฟเฟกต์
	local function ProcessObject(obj)
		if obj:IsA("BasePart") then
			obj.Material = Enum.Material.SmoothPlastic
			obj.Reflectance = 0
		elseif obj:IsA("Decal") or obj:IsA("Texture") then
			obj:Destroy()
		elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
			obj:Destroy()
		end
	end

	for _, obj in pairs(workspace:GetDescendants()) do
		ProcessObject(obj)
	end

	workspace.DescendantAdded:Connect(function(obj)
		if isFixLagActive then
			task.wait()
			ProcessObject(obj)
		end
	end)
end

FixLagBtn.MouseButton1Click:Connect(function()
	PlayClickSound()
	if not isFixLagActive then
		isFixLagActive = true
		ApplyFixLag()
		FixLagBtn.Text = "⚡ แก้แลค (ทำงานแล้ว)"
		FixLagBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
	end
end)

-- [[ ระบบเปิด/ปิด วิ่งไว ]]
local isSpeedEnabled = false
local speedMultiplier = 10
local speedConnection = nil

local function EnableSpeedLoop()
	if speedConnection then speedConnection:Disconnect() end
	speedConnection = RunService.Stepped:Connect(function()
		if isSpeedEnabled and player.Character then
			local humanoid = player.Character:FindFirstChild("Humanoid")
			if humanoid then
				humanoid.WalkSpeed = 16 * speedMultiplier
			end
		end
	end)
end

local function DisableSpeedLoop()
	if speedConnection then
		speedConnection:Disconnect()
		speedConnection = nil
	end
	if player.Character then
		local humanoid = player.Character:FindFirstChild("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = 16
		end
	end
end

SpeedBtn.MouseButton1Click:Connect(function()
	PlayClickSound()
	isSpeedEnabled = not isSpeedEnabled
	
	if isSpeedEnabled then
		EnableSpeedLoop()
		SpeedBtn.Text = "⚡ วิ่งไว (ON)"
		SpeedBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
	else
		DisableSpeedLoop()
		SpeedBtn.Text = "⚡ วิ่งไว (OFF)"
		SpeedBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end
end)

-- [[ ระบบเปิด/ปิด กระโดดสูง ]]
local isJumpEnabled = false
local jumpPowerValue = 150
local jumpConnection = nil

local function EnableJumpLoop()
	if jumpConnection then jumpConnection:Disconnect() end
	jumpConnection = RunService.Stepped:Connect(function()
		if isJumpEnabled and player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.UseJumpPower = true
				humanoid.JumpPower = jumpPowerValue
				humanoid.JumpHeight = jumpPowerValue / 3
			end
		end
	end)
end

local function DisableJumpLoop()
	if jumpConnection then
		jumpConnection:Disconnect()
		jumpConnection = nil
	end
	if player.Character then
		local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.JumpPower = 50
			humanoid.JumpHeight = 7.2
		end
	end
end

