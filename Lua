-- CLEANUP + MAIN LOOP (ลดความถี่: stats 10 ครั้ง/วิ, visual 2 ครั้ง/วิ, ESP 5 ครั้ง/วิ)
--==================================================
local loop
local accStats, accVis = 0, 0
loop = RunService.Heartbeat:Connect(function(dt)
    if not Fluent.Unloaded then
        accStats += dt
        if accStats >= 0.1 then accStats = 0 ApplyStats() end
        accVis += dt
        if accVis >= 0.5 then accVis = 0 ApplyVisuals() end
        UpdateESP()
        return
    end

    loop:Disconnect()
    ClearESP()
    StopFly()
    StopSpectate()
    StopFollow()
    Settings.WalkOn, Settings.JumpOn, Settings.BrightOn, Settings.NoFog = false, false, false, false
    RestoreWalk()
    RestoreJump()
    Restore(BrightProps)
    RestoreFog()
    Settings.Boost = false
    SetBoost(false)
    Restore(BoostProps)
    for _, c in ipairs(Links) do c:Disconnect() end
    table.clear(Links)
end)

