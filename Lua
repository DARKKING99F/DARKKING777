local Cats = {
    Player = { on = false, info = true, color = C(255, 255, 255), tag = "Player" },
    Item   = { on = false, info = true, color = C(255, 220, 60),   tag = "Item"   },
}
local Entries = {} -- [key] = { kind, hl, bb, label, adornee, hum, name, text }

local function RemoveEntry(key)
    local e = Entries[key]
    if not e then return end
    Entries[key] = nil
    if e.hl then e.hl:Destroy() end
    if e.bb then e.bb:Destroy() end
end

local function AddEntry(kind, key, hlTarget, adornee, hum, name)
    local cat = Cats[kind]
    if not cat.on or Entries[key] or not (key.Parent and adornee.Parent) then return end

    local col = cat.color
    local hl = New("Highlight", {
        Name = "DarkHubHighlight", Adornee = hlTarget, FillColor = col, OutlineColor = col,
        FillTransparency = 0.8, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    }, hlTarget)
    local bb = New("BillboardGui", {
        Name = "DarkHubInfo", Adornee = adornee, Size = UDim2.fromOffset(190, 60),
        StudsOffset = Vector3.new(0, 2.5, 0), AlwaysOnTop = true, Enabled = cat.info,
    }, adornee)
    local label = New("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        TextSize = 12, TextColor3 = col, TextStrokeTransparency = 0.25,
    }, bb)

    Entries[key] = { kind = kind, hl = hl, bb = bb, label = label, adornee = adornee, hum = hum, name = name, text = "" }
end

-- ESP ผู้เล่นเท่านั้น: ไม่ตรวจจับ Humanoid ที่ไม่ใช่ผู้เล่น
local function AddHumanoid(hum)
    local model = hum.Parent
    if not (model and model:IsA("Model")) then return end

    local plr = Players:GetPlayerFromCharacter(model)
    if not plr or plr == LP or not Cats.Player.on then return end

    local root = hum.RootPart or model:FindFirstChild("HumanoidRootPart")
    root = root or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not root then return end

    local head = model:FindFirstChild("Head")
    AddEntry("Player", model, model,
        (head and head:IsA("BasePart")) and head or root,
        hum, plr.DisplayName)
end

-- ไอเท็ม: Tool ที่วางอยู่ในแมพ
local function AddTool(tool)
    if not Cats.Item.on then return end
    if tool.Parent and tool.Parent:FindFirstChildOfClass("Humanoid") then return end
    local part = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart", true)
    if part and part:IsA("BasePart") then AddEntry("Item", tool, part, part, nil, tool.Name) end
end

-- ไอเท็ม: ของที่กดเก็บ/โต้ตอบได้ (ProximityPrompt)
local function AddPrompt(prompt)
    if not Cats.Item.on then return end
    local part = prompt.Parent
    if part and part:IsA("Attachment") then part = part.Parent end
    if not (part and part:IsA("BasePart")) then return end

    local model = part:FindFirstAncestorOfClass("Model")
    if model and model:FindFirstChildOfClass("Humanoid") then return end -- ของติดตัว NPC/ผู้เล่น ข้าม

    local target = part
    if model and model:GetExtentsSize().Magnitude <= 40 then target = model end -- โมเดลเล็ก = ไฮไลต์ทั้งชิ้น
    local name = prompt.ObjectText ~= "" and prompt.ObjectText or (target ~= part and target.Name) or part.Name
    AddEntry("Item", target, target, part, nil, name)
end

local function Consider(inst)
    if inst:IsA("Humanoid") then
        if Cats.Player.on then AddHumanoid(inst) end
    elseif Cats.Item.on then
        if inst:IsA("Tool") then AddTool(inst)
        elseif inst:IsA("ProximityPrompt") then AddPrompt(inst) end
    end
end

local scanGen = 0
local scanning = false
local scanPending = false

local function Rescan()
    scanGen += 1

    -- ถ้ามีการกดเปิดอีกหมวดระหว่างสแกน ให้สแกนรอบใหม่ต่อหลังรอบปัจจุบันหยุด
    if scanning then
        scanPending = true
        return
    end

    scanning = true
    task.spawn(function()
        repeat
            scanPending = false
            local gen = scanGen
            local slice = Slicer()

            local ok, descendants = pcall(function() return workspace:GetDescendants() end)
            if ok and type(descendants) == "table" then
                for _, inst in ipairs(descendants) do
                    if gen ~= scanGen then break end
                    pcall(Consider, inst)
                    slice()
                end
            end
        until not scanPending and scanGen == gen

        scanning = false
    end)
end

local function SetCat(kind, on)
    Cats[kind].on = on
    if on then
        if kind == "Player" then
            -- ตรวจเฉพาะรายชื่อผู้เล่นจริง ไม่ไล่สแกน Workspace ทั้งหมด
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LP and player.Character then
                    local hum = player.Character:FindFirstChildOfClass("Humanoid")
                    if hum then AddHumanoid(hum) end
                end
            end
        else
            Rescan()
        end
    else
        for key, e in next, Entries do
            if e.kind == kind then RemoveEntry(key) end
        end
    end
end

local function ClearESP()
    scanGen += 1
    for _, cat in next, Cats do cat.on = false end
    for key in next, Entries do RemoveEntry(key) end
end

-- ถ้าไม่มี ESP หมวดไหนเปิดอยู่ ไม่ต้องเสียเวลาเช็กของใหม่ที่เข้ามาในแมพเลย
Track(workspace.DescendantAdded:Connect(function(inst)
    if Cats.Player.on or Cats.Item.on then pcall(Consider, inst) end
end))

local lastESP = 0
local function UpdateESP() -- อัปเดต ~5 ครั้ง/วินาที
    local now = os.clock()
    if now - lastESP < 0.2 then return end
    lastESP = now
    if next(Entries) == nil then return end

    local cam = workspace.CurrentCamera
    if not cam then return end
    local camPos = cam.CFrame.Position

    for key, e in next, Entries do
        if not (key.Parent and e.adornee.Parent and key:IsDescendantOf(workspace)) then
            RemoveEntry(key)
        else
            local cat = Cats[e.kind]
            if e.hl.FillColor ~= cat.color then
                e.hl.FillColor, e.hl.OutlineColor = cat.color, cat.color
            end
            if e.label.TextColor3 ~= cat.color then
                e.label.TextColor3 = cat.color
            end
            if e.bb.Enabled ~= cat.info then
                e.bb.Enabled = cat.info
            end

            if cat.info then
                local text = string.format("[%s] %s\n%d studs", cat.tag, e.name,
                    math.floor((camPos - e.adornee.Position).Magnitude))
                if e.hum and e.hum.Parent then
                    text ..= string.format(" | HP: %d/%d", math.floor(e.hum.Health), math.floor(e.hum.MaxHealth))
                end
                if text ~= e.text then -- เขียนเฉพาะตอนข้อความเปลี่ยนจริง
                    e.text = text
                    e.label.Text = text
                end
            end
        end
    end
end

