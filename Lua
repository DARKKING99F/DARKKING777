local function UpdateHUDText()
    if not HUD.frame or not HUD.gui or not HUD.gui.Enabled then return end
    local ping = 0
    pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5) end)
    local root = GetRoot()
    local px, py, pz = 0, 0, 0
    if root then px, py, pz = root.Position.X, root.Position.Y, root.Position.Z end

    local fpsVal = HUD.rows.FPS
    if fpsVal then
        fpsVal.Text = tostring(HUD.fps)
        fpsVal.TextColor3 = HUD.fps >= 50 and C(90, 220, 150)
            or (HUD.fps >= 30 and C(255, 200, 80) or C(255, 100, 100))
    end

    local pingVal = HUD.rows.Ping
    if pingVal then
        pingVal.Text = ping .. " ms"
        pingVal.TextColor3 = ping < 100 and C(90, 220, 150)
            or (ping < 200 and C(255, 200, 80) or C(255, 100, 100))
    end

    local posVal = HUD.rows.Pos
    if posVal then
        posVal.Text = string.format("%.0f, %.0f, %.0f", px, py, pz)
    end

    local playersVal = HUD.rows.Players
    if playersVal then
        playersVal.Text = tostring(#Players:GetPlayers())
    end
end

local function UpdateHUDFps(dt)
    HUD.fpsAccum += dt
    HUD.fpsCount += 1
    if HUD.fpsAccum >= 0.5 then
        HUD.fps = math.floor(HUD.fpsCount / HUD.fpsAccum + 0.5)
        HUD.fpsAccum, HUD.fpsCount = 0, 0
    end
end

