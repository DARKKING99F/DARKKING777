local function New(class, props, parent)
    local o = Instance.new(class)
    for k, v in next, props do o[k] = v end
    o.Parent = parent
    return o
end

local function Slicer(budget)
    budget = budget or 0.004
    local t = os.clock()
    return function()
        if os.clock() - t > budget then task.wait() t = os.clock() end
    end
end

local function WalkTree(root, cb, slice)
    if not root then return end
    slice = slice or Slicer()
    local queue, n = { root }, 1
    while n > 0 do
        local cur = queue[n]; queue[n] = nil; n -= 1
        local ok, kids = pcall(function() return cur:GetChildren() end)
        if ok and kids then
            for i = 1, #kids do
                local k = kids[i]
                local okCall, stop = pcall(cb, k)
                if okCall and stop then return end
                n += 1; queue[n] = k; slice()
            end
        end
    end
end

