--==================================================
local Orig = {}

local function RestoreWalk()
    local hum = GetHumanoid()
    if hum and Orig.Walk then hum.WalkSpeed = Orig.Walk end
    Orig.Walk = nil
end

local function RestoreJump()
    local hum = GetHumanoid()
    if hum and Orig.Jump then hum[Orig.UsePower and "JumpPower" or "JumpHeight"] = Orig.Jump end
    Orig.Jump, Orig.UsePower = nil, nil
end

local function ApplyStats()
    if FC.on then return end -- Freecam freezes the body; don't fight it
    if not (Settings.WalkOn or Settings.JumpOn) then return end
    local hum = GetHumanoid()
    if not hum then return end
    if Settings.WalkOn then
        Orig.Walk = Orig.Walk or hum.WalkSpeed
        local v = WALK_BASE * Settings.WalkLevel
        if hum.WalkSpeed ~= v then hum.WalkSpeed = v end
    end
    if Settings.JumpOn then
        local power = JUMP_BASE * Settings.JumpLevel
        if Orig.Jump == nil then
            Orig.UsePower = hum.UseJumpPower
            Orig.Jump = hum.UseJumpPower and hum.JumpPower or hum.JumpHeight
        end
        if hum.UseJumpPower then
            if hum.JumpPower ~= power then hum.JumpPower = power end
        else
            local h = power ^ 2 / (2 * workspace.Gravity)
            if hum.JumpHeight ~= h then hum.JumpHeight = h end
        end
    end
end

