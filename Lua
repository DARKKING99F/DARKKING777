local function SwapText(oldLang, newLang)
    local ok, root = pcall(function() return Fluent.GUI or Window.Root end)
    if not (ok and root) then return false end

    local rev, to = REV[oldLang], STR[newLang]
    task.spawn(function()
        local slice = Slicer()
        for _, inst in ipairs(root:GetDescendants()) do
            if inst:IsA("TextLabel") or inst:IsA("TextButton") then
                local k = rev[inst.Text]
                if k and to[k] and inst.Text ~= to[k] then inst.Text = to[k] end
            end
            slice()
        end
    end)
    return true
end

