--==================================================
-- NOTIFY (custom, bottom-right)
-- Note(title, content, duration, kind)
-- kind = "info" | "success" | "warn" | "error"  (default: info)
--==================================================
local Note
do
    local TweenService, TextService = game:GetService("TweenService"), game:GetService("TextService")

    local NW, MAX_NOTES = 290, 5
    local KINDS = {
        info    = { color = C(90, 160, 255),  icon = "i" },
        success = { color = C(90, 220, 150),  icon = "+" },
        warn    = { color = C(255, 200, 80),  icon = "!" },
        error   = { color = C(255, 100, 100), icon = "x" },
    }

    local NotifyGui = New("ScreenGui", {
        Name = "DarkHubNotify", ResetOnSpawn = false, DisplayOrder = 1000, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    if not pcall(function() NotifyGui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end) then
        NotifyGui.Parent = LP:WaitForChild("PlayerGui")
    end

    local Holder = New("Frame", {
        BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -16, 1, -16), Size = UDim2.new(0, NW, 1, -32),
    }, NotifyGui)
    New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8),
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
    }, Holder)

    local noteOrder, activeNotes = 0, {}
    local EASE_OUT = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local EASE_IN  = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

    Note = function(title, content, dur, kind)
        if Fluent.Unloaded then return end
        dur = tonumber(dur) or 4
        local k = KINDS[kind] or KINDS.info
        title, content = tostring(title or ""), tostring(content or "")

        -- too many on screen -> dismiss the oldest
        if #activeNotes >= MAX_NOTES then
            local oldest = table.remove(activeNotes, 1)
            if oldest then oldest() end
        end

        local textW = NW - 58
        local size = TextService:GetTextSize(content, 12, Enum.Font.GothamMedium, Vector2.new(textW, 1000))
        local H = math.max(58, 32 + size.Y + 14)

        noteOrder += 1
        local wrap = New("Frame", {
            BackgroundTransparency = 1, Size = UDim2.fromOffset(NW, 0), LayoutOrder = noteOrder,
        }, Holder)

        local card = New("Frame", {
            BackgroundColor3 = C(18, 18, 24), BackgroundTransparency = 0.08, BorderSizePixel = 0,
            Size = UDim2.fromOffset(NW, H), Position = UDim2.fromOffset(NW + 40, 0), ClipsDescendants = true,
        }, wrap)
        New("UICorner", { CornerRadius = UDim.new(0, 10) }, card)
        local stroke = New("UIStroke", {
            Thickness = 1.2, Color = k.color, Transparency = 0.55, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, card)
        New("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, C(38, 38, 52)),
                ColorSequenceKeypoint.new(1, C(16, 16, 22)),
            }), Rotation = 110,
        }, card)

        -- accent bar (left)
        New("Frame", { BackgroundColor3 = k.color, BorderSizePixel = 0, Size = UDim2.new(0, 3, 1, 0) }, card)

        -- icon badge
        local badge = New("Frame", {
            BackgroundColor3 = k.color, BackgroundTransparency = 0.8, BorderSizePixel = 0,
            Position = UDim2.fromOffset(14, 11), Size = UDim2.fromOffset(24, 24),
        }, card)
        New("UICorner", { CornerRadius = UDim.new(1, 0) }, badge)
        New("UIStroke", { Thickness = 1, Color = k.color, Transparency = 0.4 }, badge)
        New("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = Enum.Font.GothamBold,
            TextSize = 14, TextColor3 = k.color, Text = k.icon,
        }, badge)

        -- title + content
        New("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(48, 10), Size = UDim2.new(1, -86, 0, 16),
            Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C(240, 240, 245),
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = title,
        }, card)
        New("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(48, 29), Size = UDim2.fromOffset(textW, size.Y),
            Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = C(165, 170, 185),
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true, Text = content,
        }, card)

        -- close "x" hint
        New("TextLabel", {
            BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8),
            Size = UDim2.fromOffset(14, 14), Font = Enum.Font.GothamBold, TextSize = 12,
            TextColor3 = C(110, 115, 130), Text = "x",
        }, card)

        -- countdown bar
        local barBack = New("Frame", {
            BackgroundColor3 = C(255, 255, 255), BackgroundTransparency = 0.94, BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 3),
        }, card)
        local bar = New("Frame", { BackgroundColor3 = k.color, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, barBack)

        -- click anywhere to dismiss
        local hit = New("TextButton", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 10 }, card)

        local closed = false
        local function close()
            if closed then return end
            closed = true
            for i, fn in ipairs(activeNotes) do if fn == close then table.remove(activeNotes, i) break end end
            TweenService:Create(card, EASE_IN, { Position = UDim2.fromOffset(NW + 40, 0), BackgroundTransparency = 1 }):Play()
            local shrink = TweenService:Create(wrap, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out,
                0, false, 0.12), { Size = UDim2.fromOffset(NW, 0) })
            shrink.Completed:Connect(function() wrap:Destroy() end)
            shrink:Play()
        end
        table.insert(activeNotes, close)
        hit.MouseButton1Click:Connect(close)

        -- hover = highlight border
        hit.MouseEnter:Connect(function() TweenService:Create(stroke, TweenInfo.new(0.15), { Transparency = 0.1 }):Play() end)
        hit.MouseLeave:Connect(function() TweenService:Create(stroke, TweenInfo.new(0.15), { Transparency = 0.55 }):Play() end)

        -- slide in
        TweenService:Create(wrap, EASE_OUT, { Size = UDim2.fromOffset(NW, H) }):Play()
        TweenService:Create(card, EASE_OUT, { Position = UDim2.fromOffset(0, 0) }):Play()
        TweenService:Create(bar, TweenInfo.new(dur, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(0, 1) }):Play()
        task.delay(dur, close)
    end

    -- cleanup when the script is unloaded
    task.spawn(function()
        while not Fluent.Unloaded do task.wait(0.5) end
        if NotifyGui then NotifyGui:Destroy() end
    end)
end

