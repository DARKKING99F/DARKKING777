local Saved, SavedAtmo = {}, {}
local BrightProps = { "Brightness", "Ambient", "OutdoorAmbient", "ClockTime", "GlobalShadows", "ExposureCompensation" }
local FogProps = { "FogEnd" }
local BoostProps = { "GlobalShadows", "EnvironmentDiffuseScale", "EnvironmentSpecularScale" }

local function Save(props)
    for _, p in ipairs(props) do
        if Saved[p] == nil then Saved[p] = Lighting[p] end
    end
end

-- ข้าม GlobalShadows ถ้าระบบอื่น (Bright/Boost) ยังต้องใช้ค่าอยู่
local function Restore(props)
    for _, p in ipairs(props) do
        if Saved[p] ~= nil then
            local inUse = false
            if p == "GlobalShadows" then
                if props == BrightProps and Settings.Boost then inUse = true
                elseif props == BoostProps and Settings.BrightOn then inUse = true end
            end
            if not inUse then
                Lighting[p] = Saved[p]
                Saved[p] = nil
            end
        end
    end
end

local function RestoreFog()
    Restore(FogProps)
    for atm, v in next, SavedAtmo do
        if atm.Parent then atm.Density, atm.Haze = v[1], v[2] end
        SavedAtmo[atm] = nil
    end
end

local function SetL(prop, val)
    if Lighting[prop] ~= val then Lighting[prop] = val end
end

local function ApplyBrightnessOnly()
    if not Settings.BrightOn then return end
    Save(BrightProps)
    local t = Settings.BrightLevel / 10
    SetL("Brightness", 1 + t * 3)
    SetL("Ambient", Color3.new(t, t, t))
    SetL("OutdoorAmbient", Color3.new(t, t, t))
    SetL("ExposureCompensation", (t - 0.5) * 2)
    SetL("ClockTime", 14)
    SetL("GlobalShadows", false)
end

local function ApplyVisuals()
    ApplyBrightnessOnly()

    if Settings.NoFog then
        Save(FogProps)
        SetL("FogEnd", 1e6)
        local atm = Lighting:FindFirstChildOfClass("Atmosphere")
        if atm then
            SavedAtmo[atm] = SavedAtmo[atm] or { atm.Density, atm.Haze }
            if atm.Density ~= 0 then atm.Density = 0 end
            if atm.Haze ~= 0 then atm.Haze = 0 end
        end
    end

    if Settings.Boost then
        Save(BoostProps)
        SetL("GlobalShadows", false)
        SetL("EnvironmentDiffuseScale", 0)
        SetL("EnvironmentSpecularScale", 0)
    end
end

