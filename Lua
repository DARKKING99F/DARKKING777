-- VISUAL (แก้ Lighting ฝั่งเรา เห็นแค่เราคนเดียว)
--==================================================
local Saved, SavedAtmo = {}, {}
local BrightProps = { "Brightness", "Ambient", "OutdoorAmbient", "ClockTime", "GlobalShadows", "ExposureCompensation" }
local FogProps = { "FogEnd" }
local BoostProps = { "GlobalShadows", "EnvironmentDiffuseScale", "EnvironmentSpecularScale" }

local function Save(props)
    for _, p in ipairs(props) do
        if Saved[p] == nil then Saved[p] = Lighting[p] end
    end
end

local function Restore(props)
    for _, p in ipairs(props) do
        if Saved[p] ~= nil then
            Lighting[p] = Saved[p]
            Saved[p] = nil
        end
    end
end

local function RestoreFog()
    Restore(FogProps)
    for atm, v in next, SavedAtmo do
        if atm.Parent then atm.Density, atm.Haze = v[1], v[2] end
        SavedAtmo[atm] = nil
    end
end

local function SetL(prop, val) -- เขียน Lighting เฉพาะตอนค่าเปลี่ยนจริง
    if Lighting[prop] ~= val then Lighting[prop] = val end
end

local function ApplyVisuals()
    if Settings.BrightOn then
        Save(BrightProps)
        local t = Settings.BrightLevel / 10              -- 0.1 -> 1.0
        SetL("Brightness", 1 + t * 3)                    -- 1.3 -> 4
        SetL("Ambient", Color3.new(t, t, t))
        SetL("OutdoorAmbient", Color3.new(t, t, t))
        SetL("ExposureCompensation", (t - 0.5) * 2)      -- -0.8 -> +1
        SetL("ClockTime", 14)
        SetL("GlobalShadows", false)
    end

    if Settings.NoFog then
        Save(FogProps)
        SetL("FogEnd", 1e6)
        local atm = Lighting:FindFirstChildOfClass("Atmosphere")
        if atm then
            SavedAtmo[atm] = SavedAtmo[atm] or { atm.Density, atm.Haze }
            if atm.Density ~= 0 then atm.Density = 0 end
            if atm.Haze ~= 0 then atm.Haze = 0 end
        end
    end

    if Settings.Boost then
        Save(BoostProps)
        SetL("GlobalShadows", false)
        SetL("EnvironmentDiffuseScale", 0)
        SetL("EnvironmentSpecularScale", 0)
    end
end

--------------------------------------------------
-- FPS BOOST: ลบเอฟเฟกต์ / เท็กซ์เจอร์ / รายละเอียดที่ทำให้แลค (เก็บค่าเดิมไว้คืนตอนปิด)
--------------------------------------------------
local Boost = setmetatable({}, { __mode = "k" }) -- [instance] = { prop = ค่าเดิม }
local BoostGen, BoostConn, OrigQuality = 0, {}, nil
local MapProps = { "ColorMap", "NormalMap", "MetalnessMap", "RoughnessMap" }

local function Mod(inst, prop, val)
    if inst[prop] == val then return end -- ค่าตรงอยู่แล้ว ไม่ต้องเขียน/ไม่ต้องจดซ้ำ
    local rec = Boost[inst]
    if not rec then rec = {} Boost[inst] = rec end
    if rec[prop] == nil then rec[prop] = inst[prop] end
    inst[prop] = val
end

local function Put(inst, prop, val) inst[prop] = val end

local function Reduce(inst)
    if inst:IsA("PostEffect") or inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
        or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") or inst:IsA("Clouds") then
        Mod(inst, "Enabled", false)
    elseif inst:IsA("Decal") then -- รวม Texture ด้วย (เว้นหน้าตัวละคร)
        if inst.Name ~= "face" then Mod(inst, "Transparency", 1) end
    elseif inst:IsA("SurfaceAppearance") then
        for _, p in ipairs(MapProps) do pcall(Mod, inst, p, "") end
    elseif inst:IsA("Terrain") then
        pcall(Mod, inst, "Decoration", false) -- หญ้า
        Mod(inst, "WaterWaveSize", 0)
        Mod(inst, "WaterWaveSpeed", 0)
        Mod(inst, "WaterReflectance", 0)
    elseif inst:IsA("BasePart") then
        Mod(inst, "Material", Enum.Material.SmoothPlastic)
        Mod(inst, "Reflectance", 0)
        Mod(inst, "CastShadow", false)
        if inst:IsA("MeshPart") then
            Mod(inst, "TextureID", "")
            Mod(inst, "RenderFidelity", Enum.RenderFidelity.Performance)
        end
    end
end

local function SetBoost(on)
    BoostGen += 1
    local gen = BoostGen
    for _, c in ipairs(BoostConn) do c:Disconnect() end
    table.clear(BoostConn)

    if on then
        pcall(function()
            local r = settings().Rendering
            OrigQuality = OrigQuality or r.QualityLevel
            r.QualityLevel = Enum.QualityLevel.Level01
        end)

        local roots = { workspace, Lighting }
        for _, root in ipairs(roots) do
            table.insert(BoostConn, root.DescendantAdded:Connect(function(i) pcall(Reduce, i) end))
        end

        task.spawn(function() -- แบ่งเฟรมตามเวลา ไม่ให้เกมค้างตอนเปิด
            local slice = Slicer()
            for _, root in ipairs(roots) do
                for _, inst in ipairs(root:GetDescendants()) do
                    if gen ~= BoostGen then return end
                    pcall(Reduce, inst)
                    slice()
                end
            end
            Note(T("boost_t"), T("n_boost_done"), 3)
        end)
    else
        pcall(function()
            if OrigQuality then settings().Rendering.QualityLevel = OrigQuality end
            OrigQuality = nil
        end)

        task.spawn(function()
            local slice = Slicer()
            for inst, rec in next, Boost do
                if gen ~= BoostGen then return end
                for p, v in next, rec do pcall(Put, inst, p, v) end
                Boost[inst] = nil
                slice()
            end
        end)
    end
end

--==================================================
-- TRACKING (SPECTATE / FOLLOW) — แก้ใหม่ให้ไม่แลค
--   Spectate: ใช้อีเวนต์ล้วน ไม่มีลูปทุกเฟรม
--   Follow  : ตั้งตำแหน่งตอน RenderStepped (ตรงกับภาพที่เห็น) + ปิดชน/ล้างความเร็วตอน Stepped
--             เก็บ reference ไว้ ไม่ FindFirstChild ซ้ำทุกเฟรม และไม่สร้าง CFrame ใหม่ทุกเฟรม
--==================================================
local function SetOpt(id, v)
    local o = Fluent.Options[id]
    if o and o.Value ~= v then o:SetValue(v) end
end

local Tracking = { Spec = nil, Follow = nil, Dist = 1, Height = 0.2 }
local followOffset = CFrame.new(0, Tracking.Height, Tracking.Dist)
local function UpdateOffset() followOffset = CFrame.new(0, Tracking.Height, Tracking.Dist) end

-- ---------- Spectate ----------
local specConns = {}

local function SpecApply()
    local target, cam = Tracking.Spec, workspace.CurrentCamera
    if not (target and cam) then return end
    local ch = target.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if hum and cam.CameraSubject ~= hum then cam.CameraSubject = hum end
end

local function StopSpectate()
    local was = Tracking.Spec ~= nil
    Tracking.Spec = nil
    for _, c in ipairs(specConns) do c:Disconnect() end
    table.clear(specConns)
    if not was then return end
    local cam, hum = workspace.CurrentCamera, GetHumanoid()
    if cam and hum then cam.CameraSubject = hum end
end

local function StartSpectate(plr)
    for _, c in ipairs(specConns) do c:Disconnect() end
    table.clear(specConns)
    Tracking.Spec = plr

    local function hookCam()
        local cam = workspace.CurrentCamera
        if cam then
            -- เกมดึงกล้องกลับ -> ตั้งใหม่ทันที (ทำงานเฉพาะตอนมีการเปลี่ยนจริง)
            table.insert(specConns, cam:GetPropertyChangedSignal("CameraSubject"):Connect(SpecApply))
        end
    end
    hookCam()
    table.insert(specConns, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        hookCam()
        SpecApply()
    end))
    -- เป้าหมายเกิดใหม่ -> ย้ายกล้องไปตัวใหม่
    table.insert(specConns, plr.CharacterAdded:Connect(function(char)
        task.spawn(function()
            char:WaitForChild("Humanoid", 5)
            if Tracking.Spec == plr then SpecApply() end
        end)
    end))
    SpecApply()
end

-- ---------- Follow ----------
local followConns = {}
local fTRoot, fRoot, fHum              -- reference ที่แคชไว้
local fParts, fChar = {}, nil          -- ชิ้นส่วนที่ต้องปิดการชน (เฉพาะชิ้นที่ชนอยู่จริง ~4 ชิ้น)

local function CacheParts(char)
    fChar, fParts = char, {}
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then table.insert(fParts, p) end
    end
end

local function RestoreCollide()
    for _, p in ipairs(fParts) do
        if p.Parent then p.CanCollide = true end
    end
    fParts, fChar = {}, nil
end

local function StopFollow()
    local was = Tracking.Follow ~= nil or #followConns > 0
    Tracking.Follow = nil
    for _, c in ipairs(followConns) do c:Disconnect() end
    table.clear(followConns)
    fTRoot, fRoot, fHum = nil, nil, nil
    if not was then return end -- ไม่ได้ตามอยู่ ก็ไม่ไปแตะตัวละคร (กันชนกับระบบบิน)
    RestoreCollide()
    local hum = GetHumanoid()
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function StartFollow(plr)
    if Flying then -- ไม่ให้ชนกับระบบบิน
        StopFly()
        SetOpt("FlyToggle", false)
    end
    Tracking.Follow = plr
    fTRoot = nil -- บังคับหา root ของเป้าหมายใหม่
    if #followConns > 0 then return end -- ใช้ connection เดิม แค่เปลี่ยนเป้าหมาย

    -- ก่อนฟิสิกส์: ปิดการชน + ล้างความเร็ว (Humanoid เปิดการชนกลับทุกสเต็ป)
    table.insert(followConns, RunService.Stepped:Connect(function()
        if not (fRoot and fRoot.Parent) then return end
        for _, p in ipairs(fParts) do
            if p.CanCollide then p.CanCollide = false end
        end
        fRoot.AssemblyLinearVelocity = Vector3.zero
        fRoot.AssemblyAngularVelocity = Vector3.zero
    end))

    -- ก่อนวาดภาพ: วางตัวเราติดหลังเป้าหมายตามตำแหน่งที่เห็นอยู่ตอนนั้นพอดี
    table.insert(followConns, RunService.RenderStepped:Connect(function()
        local target = Tracking.Follow
        if not target then return end

        if not (fTRoot and fTRoot.Parent) then
            local ch = target.Character
            fTRoot = ch and ch:FindFirstChild("HumanoidRootPart")
            if not fTRoot then return end -- รอเป้าหมายเกิดใหม่
        end

        local char = LP.Character
        if not char then return end
        if char ~= fChar or not (fRoot and fRoot.Parent) then
            fRoot = char:FindFirstChild("HumanoidRootPart")
            fHum = char:FindFirstChildOfClass("Humanoid")
            if not fRoot then return end -- รอเราเกิดใหม่
            CacheParts(char)
        end

        if fHum and not fHum.PlatformStand then fHum.PlatformStand = true end
        fRoot.CFrame = fTRoot.CFrame * followOffset -- Z บวก = ด้านหลังเป้าหมาย (หันไปทางเดียวกับเขา)
    end))
end

-- เป้าหมายออกจากเซิร์ฟ: ใช้อีเวนต์เดียว แทนการเช็กทุกเฟรม
Track(Players.PlayerRemoving:Connect(function(p)
    if p == Tracking.Spec then
        StopSpectate()
        SetOpt("SpecToggle", false)
        Note(T("spec_t"), T("n_spec_left"))
    end
    if p == Tracking.Follow then
        StopFollow()
        SetOpt("FollowToggle", false)
        Note(T("fol_t"), T("n_fol_left"))
    end
end))

