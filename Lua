do
    local Gui = New("ScreenGui", { Name = "DarkHubIcon", ResetOnSpawn = false, DisplayOrder = 999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
    if not pcall(function() Gui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end) then
        Gui.Parent = LP:WaitForChild("PlayerGui")
    end
    local Btn = New("TextButton", {
        Name = "Icon", Size = UDim2.fromOffset(52, 52), Position = UDim2.new(0, 24, 0.5, -26),
        AutoButtonColor = false, Text = "D", Font = Enum.Font.GothamBold, TextSize = 28, Visible = false,
    }, Gui)
    New("UICorner", { CornerRadius = UDim.new(1, 0) }, Btn)
    local Stroke = New("UIStroke", { Thickness = 2 }, Btn)
    local function IsPointer(i, move)
        local t = i.UserInputType
        return t == Enum.UserInputType.Touch or t == (move and Enum.UserInputType.MouseMovement or Enum.UserInputType.MouseButton1)
    end
    local dragging, moved, dragStart, startPos = false, false, nil, nil
    Track(Btn.InputBegan:Connect(function(i)
        if IsPointer(i) then dragging, moved, dragStart, startPos = true, false, i.Position, Btn.Position end
    end))
    Track(UIS.InputChanged:Connect(function(i)
        if not (dragging and IsPointer(i, true)) then return end
        local d = i.Position - dragStart
        if d.Magnitude > 6 then moved = true end
        if moved then
            Btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    Track(UIS.InputEnded:Connect(function(i)
        if not (dragging and IsPointer(i)) then return end
        dragging = false
        if not moved then Window:Minimize() end
    end))
    task.spawn(function()
        local lastTheme, lastVis
        while not Fluent.Unloaded do
            local vis = Window.Minimized == true
            if vis ~= lastVis then Btn.Visible = vis lastVis = vis end
            local theme = Fluent.Theme
            if theme ~= lastTheme then
                lastTheme = theme
                local light = theme == "Light"
                local bg, fg = light and C(245, 247, 250) or C(3, 3, 3), light and C(20, 20, 22) or C(255, 255, 255)
                Btn.BackgroundColor3, Btn.TextColor3, Stroke.Color = bg, fg, fg
            end
            task.wait(0.25)
        end
        Gui:Destroy()
    end)
end
